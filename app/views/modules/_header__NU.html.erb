        <a href="#main-content" class="screen-reader-shortcut">Skip to main content</a>
        <div id="top-bar">
            <div class="contain-1120">
                <div id="left">
                    <div id="northwestern">
                        <a href="http://www.northwestern.edu/" title="Northwestern University Home"><span class="hide-label">Northwestern University</span></a>
                    </div>
                    <div id="parent-unit">
                        <a href="#">Parent Unit Name</a>
                    </div>
                </div>
                
                <nav id="global-links" aria-label="global links">
                    <ul>
                        <li>
                            <% if user_signed_in? %>
                            <%= link_to user_key + " | " + t('auth.sign_out'), main_app.destroy_user_session_path %>
                            <% else %>
                            <%= link_to t('auth.sign_in'), main_app.new_user_session_path %>
                            <% end %>
                        </li>
                    </ul>
                </nav>
    
            </div>
        </div>
