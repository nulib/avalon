<div class="custom-header">
  <div class="container-md">
    <header class="header-wrapper">
      <div class="header-logo">
        <%# AVR: Northwestern wordmark in place of the Avalon logo. The SVG is
            white-only, which is why nulib/_avr.scss makes this bar purple. %>
        <%= link_to main_app.root_path do %>
        <%= image_tag "nulib/northwestern-white.svg", class: "img-fluid", alt: "Northwestern University Libraries - Repository Audio + Video" %>
        <% end %>
      </div>

      <% unless current_page?(main_app.root_path) %>
      <div class="header-search">
        <%= render :partial=>'modules/avalon_search_form' %>
      </div>
      <% end %>

      <%# By default shift log in / log out to the header %>
      <div class="text-end log-in-out text-muted header-user">
        <%= render 'modules/user_management' %>
      </div>
    </header>
  </div>
</div>
