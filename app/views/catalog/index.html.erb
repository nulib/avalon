%>
<% if current_page?(main_app.root_path) %>
<div class="full-width-page">
  <section class="hero">
      <!-- The hero image can align to left/center/right on mobile by changing the inline background-position property in .hero-image -->
      <div class="hero-image homepage">
          <div class="contain-1120">
              <h1>Repository Audio + Video</h1>
              <p>Audio and video material for research and courses</p>
              <%= link_to 'Browse Collection', main_app.search_catalog_path(search_field: 'all_fields', utf8: '✓', q: ''), class: "button" %>
          </div>
      </div>
  </section>
  <div class="content">
    <section>
      <div class="section-top contain-970">
          <h2>Featured Collections</h2>
          <p>Some content is only available when you sign in. Sign in with your ID and passphrase.</p>
      </div>
      <div class="photo-feature-3-across">
          <article class="photo-feature">
              <a href="/catalog?f%5Bcollection_ssim%5D%5B%5D=Robert+Marcellus+Master+Class+Audio+Archives" style="border: none;">
                  <%= image_tag("nulib/featured-collection-marcellus.jpg", alt: "Robert Marcellus") %>
                  <div class="text-over-image">
                      <h3>Robert Marcellus master class audio archives</h3>
                      <div class="cta">View items</div>
                  </div>                       
              </a>     
          </article>
          <article class="photo-feature">
              <a href="/?f%5Bcollection_ssim%5D%5B%5D=The+Dharma+Talks+of+Kongo+Langlois+Roshi" style="border: none;">
                  <%= image_tag("nulib/featured-collection-kongo.jpg", alt: "Kongo Langlois Roshi") %>
                  <div class="text-over-image">
                      <h3>The Dharma Talks of Kongo Langlois Roshi</h3>
                      <div class="cta">View items</div>
                  </div>
              </a>
          </article>       
          <article class="photo-feature">
              <a href="/?f%5Bcollection_ssim%5D%5B%5D=Northwestern+University+Football+Films" style="border: none;">
                  <%= image_tag("nulib/featured-collection-nu-football.jpg", alt: "Go Northwestern banner") %>
                  <div class="text-over-image">
                      <h3>Northwestern University football films</h3>
                      <div class="cta">View items</div>
                  </div>
              </a>
          </article> 
      </div>
    </section>
  </div>
</div>
<% else %>
<div id="sidebar" class="<%= sidebar_classes %>">
  <%= render 'search_sidebar' %>
</div>

<div id="content" class="<%= main_content_classes %>">
  <%= render 'search_results' %>
</div>
<% end %>
